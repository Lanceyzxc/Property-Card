# Server-only monitoring configuration. Copy to .env.local for local use.
FIREBASE_USAGE_PROJECT_ID=ucn-property-tag-b7e0a
FIREBASE_USAGE_DATABASE_ID=(default)

# Paste the service-account JSON as a SINGLE-LINE secret in Vercel settings.
# Leave empty until configured. Never put credentials under public/.
GOOGLE_SERVICE_ACCOUNT_JSON=

# Alternative to the JSON secret: opt into platform/local application default
# credentials. Configure workload identity externally before selecting adc.
FIREBASE_USAGE_AUTH=
